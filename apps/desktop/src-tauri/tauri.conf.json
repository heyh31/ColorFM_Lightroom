{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ColorFM-LR",
  "version": "0.1.0",
  "identifier": "com.colorfm.lr",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run build && node ../../scripts/check-port.mjs 1420 && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../.. run build && node ../../scripts/package-engine.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ColorFM-LR",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "maximizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/ColorFM-LR/tasks/**",
          "$DOCUMENT/ColorFM-LR/cache/**",
          "$DOCUMENT/ColorFM-LR/history/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../../../models/colorfm_l.onnx": "models/colorfm_l.onnx",
      "../../../build/engine": "engine",
      "../../../hosts/lightroom/colorfm.lrplugin": "lightroom/colorfm.lrplugin"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
